# ============================================================
# DRONE PLATFORM — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- PostgreSQL / PostGIS ---
POSTGRES_USER=droneuser
POSTGRES_PASSWORD=dronepass
POSTGRES_DB=dronedb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- FastAPI Backend ---
SECRET_KEY=supersecret-change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Demo / Simulation Mode ---
# Set to "true" to use mock drone, mock inference, and mock sensor ingestor
USE_MOCK_DRONE=true

# --- MinIO / S3-compatible Object Storage ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_NAME=drone-data
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=ap-south-1

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
# Optional: set a MapTiler or Mapbox key for higher-quality basemaps
# NEXT_PUBLIC_MAPTILER_KEY=your_key_here

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
